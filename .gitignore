# 源数据（20 GB 栅格 / netCDF），不入库
data/

# 归档区（2.4 GB，2026-09-06 从主线移出，见 _archive_20260906/README.md）
_archive_20260906/

# 可再生的缓存与构建产物
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/
.ruff_cache/

# 机器本地 / 按 .claude/rules/security.md 不入库
.claude/settings.json
.claude/settings.local.json

# Loose solve outputs. Real results are deposited into results/figures/<version>/data/
# by scripts/render_version.py; anything else here is a scratch or validation run and must
# never be mistaken for a published one (CLAUDE.md 二.6).
/results/*
!/results/figures/

# v9.1 solve tree: inputs are a frozen copy, data is a junction to the main data/.
# Deposited results live in results/figures/v9.1/ via scripts/render_version.py.
_v91tree/results/
_v91tree/data
